{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "daily-report-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "DASHBOARD_DATA",
      "id": "68305450aed14c978ace7f65a04486a0"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONCURRENCY_LIMITER",
        "class_name": "ConcurrencyLimiter"
      },
      {
        "name": "MANUAL_VALUES",
        "class_name": "ManualValuesStore"
      },
      {
        "name": "REPORT_VERSIONS",
        "class_name": "ReportVersionsStore"
      },
      {
        "name": "OPERATIONS_JOBS",
        "class_name": "OperationsJobsStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-concurrency-limiter",
      "new_sqlite_classes": ["ConcurrencyLimiter"]
    },
    {
      "tag": "v2-manual-values",
      "new_sqlite_classes": ["ManualValuesStore"]
    },
    {
      "tag": "v3-report-versions",
      "new_sqlite_classes": ["ReportVersionsStore"]
    },
    {
      "tag": "v4-operations-jobs",
      "new_sqlite_classes": ["OperationsJobsStore"]
    }
  ],
  "vars": {
    "GRAFANA_URL": "https://bms.bateriku.com",
    "GRAFANA_DATASOURCE_UID": "_4a9wLSVz",
    "ALLOW_LOCAL_API": "true",
    "MAX_CONCURRENT_USERS": "10",
    "ACTIVE_HEARTBEAT_SECONDS": "30",
    "ACTIVE_SESSION_TIMEOUT_SECONDS": "90",
    "QUEUE_HEARTBEAT_SECONDS": "15",
    "QUEUE_TIMEOUT_SECONDS": "60",
    "QUEUE_STATUS_POLL_SECONDS": "5",
    "CONCURRENCY_ALARM_SECONDS": "15",
    "OPERATIONS_SCHEDULED_BACKUPS": "true",
    "OPERATIONS_BACKUP_RETENTION_DAYS": "30",
    "OPERATIONS_BACKUP_MAX_PER_KIND": "31"
  }
}
