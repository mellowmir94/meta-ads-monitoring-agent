generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MetaAdsEntityLevel {
  CAMPAIGN
  AD_SET
  AD
}

enum MetaAdsEntityStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  DELETED
  UNKNOWN
}

enum MetaAdsRunStatus {
  STARTED
  SUCCESS
  FAILED
}

enum MetaAdsAlertSeverity {
  CRITICAL
  WARNING
  GOOD_NEWS
}

enum MetaAdsAlertType {
  NO_LEADS_HIGH_SPEND
  CPL_SPIKE
  LOW_CTR
  HIGH_FREQUENCY
  ZERO_IMPRESSIONS
  SPEND_UP_LEADS_DOWN
  CPM_SPIKE
  BEST_CPL
  CREATIVE_FATIGUE
  AUDIENCE_FATIGUE
  SCALING_OPPORTUNITY
  UNDERPERFORMING_PAUSE_RECOMMENDED
}

enum MetaAdsReportType {
  DAILY
  WEEKLY
}

enum MetaAdsRecommendationStatus {
  OPEN
  APPROVED
  REJECTED
  APPLIED_MANUALLY
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MetaAdsAccount {
  id           String   @id @default(cuid())
  adAccountId  String   @unique
  name         String?
  currency     String   @default("MYR")
  timezoneName String   @default("Asia/Kuala_Lumpur")
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entities           MetaAdsEntity[]
  snapshots          MetaAdsPerformanceSnapshot[]
  runs               MetaAdsAgentRun[]
  reports            MetaAdsReport[]
  alerts             MetaAdsAlert[]
  recommendedActions MetaAdsRecommendedAction[]
}

model MetaAdsEntity {
  id              String              @id @default(cuid())
  accountId       String
  metaId          String
  parentMetaId    String?
  level           MetaAdsEntityLevel
  name            String
  status          MetaAdsEntityStatus @default(UNKNOWN)
  effectiveStatus String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  account   MetaAdsAccount               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  snapshots MetaAdsPerformanceSnapshot[]
  alerts    MetaAdsAlert[]

  @@unique([accountId, metaId, level])
  @@index([accountId, level, status])
}

model MetaAdsPerformanceSnapshot {
  id           String              @id @default(cuid())
  accountId    String
  entityId     String?
  metaEntityId String
  parentMetaId String?
  level        MetaAdsEntityLevel
  name         String
  date         DateTime
  status       MetaAdsEntityStatus @default(UNKNOWN)
  spend        Float               @default(0)
  impressions  Int                 @default(0)
  reach        Int                 @default(0)
  clicks       Int                 @default(0)
  ctr          Float               @default(0)
  cpc          Float               @default(0)
  cpm          Float               @default(0)
  leads        Int                 @default(0)
  cpl          Float?
  frequency    Float               @default(0)
  raw          Json?
  createdAt    DateTime            @default(now())

  account MetaAdsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entity  MetaAdsEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@unique([accountId, metaEntityId, level, date])
  @@index([accountId, date, level])
  @@index([metaEntityId, level, date])
}

model MetaAdsAgentRun {
  id               String           @id @default(cuid())
  accountId        String?
  status           MetaAdsRunStatus @default(STARTED)
  runType          String
  startedAt        DateTime         @default(now())
  completedAt      DateTime?
  errorMessage     String?
  campaignsChecked Int              @default(0)
  adSetsChecked    Int              @default(0)
  adsChecked       Int              @default(0)
  alertsGenerated  Int              @default(0)
  reportSent       Boolean          @default(false)
  metadata         Json?

  account MetaAdsAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  reports MetaAdsReport[]
  alerts  MetaAdsAlert[]

  @@index([status, startedAt])
  @@index([accountId, startedAt])
}

model MetaAdsAlert {
  id             String               @id @default(cuid())
  accountId      String
  runId          String?
  entityId       String?
  metaEntityId   String
  level          MetaAdsEntityLevel
  severity       MetaAdsAlertSeverity
  type           MetaAdsAlertType
  title          String
  problem        String
  evidence       String
  impact         String
  recommendation String
  metric         String
  currentValue   Float?
  baselineValue  Float?
  createdAt      DateTime             @default(now())

  account MetaAdsAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  run     MetaAdsAgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  entity  MetaAdsEntity?   @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt, severity])
  @@index([metaEntityId, level, type])
}

model MetaAdsReport {
  id             String            @id @default(cuid())
  accountId      String
  runId          String?
  type           MetaAdsReportType
  periodStart    DateTime
  periodEnd      DateTime
  body           String
  sentToTelegram Boolean           @default(false)
  sentAt         DateTime?
  createdAt      DateTime          @default(now())

  account MetaAdsAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  run     MetaAdsAgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([accountId, type, createdAt])
}

model MetaAdsRecommendedAction {
  id             String                      @id @default(cuid())
  accountId      String
  metaEntityId   String
  level          MetaAdsEntityLevel
  recommendation String
  evidence       String
  status         MetaAdsRecommendationStatus @default(OPEN)
  approvedAt     DateTime?
  rejectedAt     DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  account MetaAdsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status, createdAt])
  @@index([metaEntityId, level])
}
